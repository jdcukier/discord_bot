# Discord - Spotify bot
DISCORD_APP_ID_SPOTIFY=
DISCORD_TOKEN_SPOTIFY=
DISCORD_AUTH_CHANNEL_ID_SPOTIFY=
DISCORD_SONGS_CHANNEL_ID_SPOTIFY=
# Message posted to the songs channel when the bot comes online (optional)
BOT_READY_MESSAGE_SPOTIFY=
# Activity the bot is shown as "Listening to" in Discord (optional)
BOT_LISTENING_MESSAGE_SPOTIFY=

# Spotify Auth (via Cloudflare Worker)
SPOTIFY_WORKER_URL=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Spotify
SPOTIFY_PLAYLIST_ID=
# Extra playlists chosen by triggers in the message, e.g. "link !relaxing" (optional)
# Format: name=playlistID[,playlistID...];name=playlistID  ("default" is reserved for SPOTIFY_PLAYLIST_ID)
# Names are case-insensitive letters/numbers, optionally joined by single - or _ (e.g. lo-fi, road_trip).
# If this is invalid, the error is logged and the bot only adds to the default playlist.
SPOTIFY_PLAYLIST_TRIGGERS=
# Single symbol character that marks a trigger (optional, defaults to !)
# Avoid $ (Docker Compose treats it as a variable), and # or : (hashtags and :emoji: would look like triggers)
SPOTIFY_TRIGGER_PREFIX=
# Reply "Unknown playlist: !name" when a trigger isn't configured (optional, true/false, defaults to false)
SPOTIFY_REPLY_UNKNOWN_TRIGGERS=
