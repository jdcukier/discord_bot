# Discord - Spotify bot
DISCORD_APP_ID_SPOTIFY=
DISCORD_TOKEN_SPOTIFY=
DISCORD_AUTH_CHANNEL_ID_SPOTIFY=
DISCORD_SONGS_CHANNEL_ID_SPOTIFY=
# Message posted to the songs channel when the bot comes online (optional)
BOT_READY_MESSAGE_SPOTIFY=
# Activity the bot is shown as "Listening to" in Discord (optional)
BOT_LISTENING_MESSAGE_SPOTIFY=

# Spotify Auth (via Cloudflare Worker)
SPOTIFY_WORKER_URL=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Spotify
SPOTIFY_PLAYLIST_ID=
# Playlist tags are managed in Discord with /tag and saved to SPOTIFY_TAGS_FILE.
# This only seeds that file the first time the bot starts; after that it's ignored. (optional)
# Format: name=playlistID;name=playlistID  ("default" is reserved for SPOTIFY_PLAYLIST_ID)
# Tags point to one playlist each; if several are listed, the first one other than the default is kept.
# Names are case-insensitive letters/numbers, optionally joined by single - or _ (e.g. lo-fi, road_trip).
# If this is invalid, the error is logged and the bot only adds to the default playlist.
SPOTIFY_PLAYLIST_TRIGGERS=
# Where playlist tags are saved as YAML (optional, defaults to playlist-tags.yaml; docker-compose sets
# /data/playlist-tags.yaml on a volume). A JSON file from earlier versions at the same path with a .json
# extension is converted on startup and renamed to .json.bak.
SPOTIFY_TAGS_FILE=
# Single symbol character that marks a trigger (optional, defaults to !). Can't be +, which marks
# triggers that also add to the default playlist (e.g. +relax)
# Avoid $ (Docker Compose treats it as a variable), and # or : (hashtags and :emoji: would look like triggers)
SPOTIFY_TRIGGER_PREFIX=
# Reply "Unknown playlist: !name" when a trigger isn't configured (optional, true/false, defaults to false)
SPOTIFY_REPLY_UNKNOWN_TRIGGERS=
