# General
# Message posted to the songs channel when the bot comes online (optional)
BOT_READY_MESSAGE=
# Activity the bot is shown as "Listening to" in Discord (optional)
BOT_LISTENING_MESSAGE=

# Discord - Spotify bot (required)
DISCORD_APP_ID_SPOTIFY=
DISCORD_TOKEN_SPOTIFY=
DISCORD_AUTH_CHANNEL_ID_SPOTIFY=
DISCORD_SONGS_CHANNEL_ID_SPOTIFY=

# Discord - Arcade bot (optional; skipped when the token is empty)
DISCORD_APP_ID_ARCADE=
DISCORD_TOKEN_ARCADE=

# Spotify Auth (via Cloudflare Worker)
SPOTIFY_WORKER_URL=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Spotify
SPOTIFY_PLAYLIST_ID=
