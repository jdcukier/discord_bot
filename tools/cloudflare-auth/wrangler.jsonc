/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "banger-spotify-worker",
	"main": "src/main.py",
	"compatibility_date": "2026-03-10",
	"compatibility_flags": [
		"python_workers",
		"python_dedicated_snapshot"
	],
	"observability": {
		"enabled": true
	},
	// Serve only on the custom domain, which is protected by Cloudflare Access.
	// workers.dev and preview URLs would bypass Access, so keep them off.
	"routes": [
		{
			"pattern": "spotify.jcukier.dev",
			"custom_domain": true
		}
	],
	"workers_dev": false,
	"preview_urls": false,
	"kv_namespaces": [
		{
			"binding": "SPOTIFY_TOKENS",
			"id": "b8368a2a96a54726a2b62ae7f5553a64",
			"remote": true
		}
	]
}